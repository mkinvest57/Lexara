// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  languageProfile LanguageProfile?
  vocabEntries    VocabEntry[]
  reviewSessions  ReviewSession[]
  activityLogs    ActivityLog[]

  @@map("users")
}

model LanguageProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetLanguage String // ISO code (en, es, fr, zh, ja, etc.)
  level          String // beginner, intermediate, advanced

  dailyGoalWords   Int @default(100)
  dailyGoalMinutes Int @default(15)
  dailyGoalCards   Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@map("language_profiles")
}

model Lesson {
  id        String @id @default(cuid())
  profileId String
  profile   LanguageProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title     String
  type      String // article, story, video, podcast
  sourceUrl String?
  imageUrl  String?
  level     String // beginner, intermediate, advanced

  content   String // raw text content
  wordCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentences        Sentence[]
  vocabOccurrences VocabOccurrence[]

  @@map("lessons")
}

model Sentence {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  index Int
  text  String

  audioUrl      String?
  audioStart    Float? // seconds
  audioEnd      Float? // seconds

  createdAt DateTime @default(now())

  tokens Token[]

  @@unique([lessonId, index])
  @@map("sentences")
}

model Token {
  id         String   @id @default(cuid())
  sentenceId String
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  index Int
  form  String // word as written
  lemma String? // base form (optional for MVP)

  createdAt DateTime @default(now())

  vocabOccurrences VocabOccurrence[]

  @@unique([sentenceId, index])
  @@map("tokens")
}

model VocabEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  term        String // base form of the word
  language    String // ISO code
  translation String
  notes       String?

  status Int @default(1) // 0=unknown, 1-3=learning, 4=known

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences VocabOccurrence[]
  srsItem     SRSItem?

  @@unique([userId, term, language])
  @@map("vocab_entries")
}

model VocabOccurrence {
  id           String     @id @default(cuid())
  vocabEntryId String
  vocabEntry   VocabEntry @relation(fields: [vocabEntryId], references: [id], onDelete: Cascade)

  tokenId String
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  context       String // full sentence
  encounteredAt DateTime @default(now())

  @@map("vocab_occurrences")
}

model SRSItem {
  id           String     @id @default(cuid())
  vocabEntryId String     @unique
  vocabEntry   VocabEntry @relation(fields: [vocabEntryId], references: [id], onDelete: Cascade)

  nextReview DateTime
  lastReview DateTime?
  interval   Int @default(1) // days

  successCount Int @default(0)
  failCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("srs_items")
}

model ReviewSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt DateTime @default(now())
  endedAt   DateTime?

  itemsCount   Int
  correctCount Int @default(0)

  type String @default("flashcard") // flashcard, reverse, cloze, dictation, mcq

  @@map("review_sessions")
}

model ActivityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // read, review, import
  language String

  wordsRead Int @default(0)
  minutes   Int @default(0)

  createdAt DateTime @default(now())

  @@map("activity_logs")
}
